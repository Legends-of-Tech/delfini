node_modules/
.pnpm-store/
dist/
.cache/

# Never commit transpiled .js/.js.map shadows next to TypeScript sources.
# Workspace packages are TypeScript-only; real emit targets live under dist/ (ignored above).
# Root-level .js files (e.g. eslint.config.js) are unaffected by these rules.
apps/**/*.js
apps/**/*.js.map
packages/**/*.js
packages/**/*.js.map
scripts/**/*.js
scripts/**/*.js.map

# Exception: the GitHub Action's ncc bundle IS committed. A remote
# `uses: Legends-of-Tech/delfini/apps/action@<tag>` reference fetches the repo
# at the ref and runs action.yml's `main: dist/index.js` directly — no build
# step runs for remote consumers, so the bundle must exist at the ref.
# CI keeps it honest: the release-gate job rebuilds and diffs it (freshness).
!apps/action/dist/
!apps/action/dist/**

.env
.env.local
*.tsbuildinfo
*.tgz
.claude/settings.local.json

# Per-run Delfini Skill trace artefacts (FR148) — rebuilt every run, never committed.
.delfini-trace/

# ── Internal planning record — MUST NEVER land in this public repo ──
# The Delfini BMad planning record (PRD, architecture, epics, stories,
# sprint-status, project-context, security white-paper) is cross-cutting and
# secret-dense; per ADR-2026-06-09 it lives ONLY in the closed
# Legends-of-Tech/delfini-platform repo + the private raymondht/delfini backup.
# This backstop lets a maintainer keep a LOCAL working overlay of that record
# inside their public clone (to drive BMad natively) while git physically
# refuses to stage it — see DEVELOPING the OSS packages with BMad in
# delfini-platform/DEVELOPING.md.
_bmad-output/
_bmad/
.claude/skills/bmad-*/
graphify-out/
security-white-paper.md
# The internal repo-rules CLAUDE.md (closed-platform conventions). The public
# repo's own contributor guidance is CONTRIBUTING.md, not this file.
/CLAUDE.md
