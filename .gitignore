node_modules/
.pnpm-store/
dist/
.cache/

# Never commit transpiled .js/.js.map shadows next to TypeScript sources.
# Workspace packages are TypeScript-only; real emit targets live under dist/ (ignored above).
# Root-level .js files (e.g. eslint.config.js) are unaffected by these rules.
apps/**/*.js
apps/**/*.js.map
packages/**/*.js
packages/**/*.js.map
scripts/**/*.js
scripts/**/*.js.map

# Exception: the GitHub Action's ncc bundle IS committed. A remote
# `uses: Legends-of-Tech/delfini/apps/action@<tag>` reference fetches the repo
# at the ref and runs action.yml's `main: dist/index.js` directly — no build
# step runs for remote consumers, so the bundle must exist at the ref.
# CI keeps it honest: the release-gate job rebuilds and diffs it (freshness).
!apps/action/dist/
!apps/action/dist/**

.env
.env.local
*.tsbuildinfo
*.tgz
.claude/settings.local.json

# Per-run Delfini Skill trace artefacts (FR148) — rebuilt every run, never committed.
.delfini-trace/
