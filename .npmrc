# Pin the pnpm virtual-store dir-name hashing threshold to the Windows
# default (60) so .pnpm store paths are IDENTICAL across platforms. ncc
# embeds these paths in its CONCATENATED MODULE comments inside the committed
# apps/action/dist bundle - without this, a Windows-built dist and the CI
# (Linux) rebuild differ in comment bytes and the dist-freshness gate fails.
virtual-store-dir-max-length=60
